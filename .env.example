NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Admin (recommended for Vercel). The service account may be raw JSON
# or base64-encoded JSON. Keep this server-only and never prefix it NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=
# Usually omit this and use Firestore's (default) database. Set it only if you
# intentionally created a named database.
FIREBASE_DATABASE_ID=

# Alternative to FIREBASE_SERVICE_ACCOUNT_KEY:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

ADMIN_PASSWORD=

# /generate defaults to admin / admin@1234 when these are omitted.
GENERATOR_USERNAME=admin
GENERATOR_PASSWORD=admin@1234
GENERATOR_SESSION_SECRET=
